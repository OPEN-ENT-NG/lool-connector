{
  "name": "fr.openent~lool",
  "config": {
    "main" : "fr.openent.lool.Lool",
    "probes": [
      "org.entcore.common.http.health.Neo4jProbe",
      "org.entcore.common.http.health.MongoProbe"
    ],
    "port" : 8333,
    "app-name" : "Lool",
    "app-address" : "/lool",
    "app-icon" : "Lool-large",
    "host": "https://{{ host }}",
    "ssl" : true,
    "auto-redeploy": false,
    "userbook-host": "https://{{ host }}",
    "integration-mode": "{{ integration_mode|default('HTTP') }}",
    "app-registry.port" : 8012,
    "mode" : "prod",
    {% if (loolProvider is defined) %}
      "wopi": {
        "provider": {
          "type": "{{ loolProvider }}",
          "url": "{{ loolServer }}"
        },
        "hour-duration-token": 12,
        "templates": {{ loolTemplates|default('["odt", "odp", "ods"]') }},
        "server_capabilities": {
          "DisableCopy": {{ loolDisableCopy|default('false') }},
          "DisablePrint": {{ loolDisablePrint|default('false') }},
          "DisableExport": {{ loolDisableExport|default('false') }},
          "HideExportOption": {{ loolHideExportOption|default('false') }},
          "DisableInactiveMessages": {{ loolDisableInactiveMessages|default('false') }},
          "HideUserList": {{ loolHideUserList|default('false') }},
          "HideSaveOption": {{ loolHideSaveOption|default('false') }},
          "EnableShare": {{ loolEnableShare|default('false') }},
          "EnableInsertRemoteImage": {{ loolEnableInsertRemoteImage|default('true') }},
          "HidePrintOption": {{ loolHidePrintOption|default('false') }},
          "UserCanNotWriteRelative": {{ loolUserCanNotWriteRelative|default('true') }},
          "EnableOwnerTermination": {{ loolEnableOwnerTermination|default('false') }}
        },
        "onlyoffice": {
          "editorConfig": {
            "customization": {
              "compactHeader": {{ loolOnlyofficeCompactHeader|default('true') }},
              "compactToolbar": {{ loolOnlyofficeCompactToolbar|default('true') }},
              "hideRulers": {{ loolOnlyofficeHideRulers|default('true') }},
              "hideRightMenu": {{ loolOnlyofficeHideRightMenu|default('true') }},
              "statusBar": {{ loolOnlyofficeStatusBar|default('false') }},
              "plugins": {{ loolOnlyofficePlugins|default('false') }},
              "layout": {
                "statusBar": {{ loolOnlyofficeLayoutStatusBar|default('false') }},
                "toolbar": {
                  "home": {{ loolOnlyofficeToolbarHome|default('true') }},
                  "insert": {{ loolOnlyofficeToolbarInsert|default('true') }},
                  "draw": {{ loolOnlyofficeToolbarDraw|default('true') }},
                  "layout": {{ loolOnlyofficeToolbarLayout|default('true') }},
                  "references": {{ loolOnlyofficeToolbarReferences|default('true') }},
                  "collaboration": {{ loolOnlyofficeToolbarCollaboration|default('false') }},
                  "protection": {{ loolOnlyofficeToolbarProtection|default('false') }},
                  "view": {{ loolOnlyofficeToolbarView|default('true') }}
                }
              }
            }
          }
        }
      },
    {% elif(loolProviders is defined) %}
      "wopi": {
        "providers" : {{ loolProviders }},
        "mappings" : {{ loolMappings }}
      },
    {% endif %}
    "entcore.port" : 8009
  }
}